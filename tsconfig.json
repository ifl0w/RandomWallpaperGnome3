          "ES2022"
        ],
        "sourceMap": false,
        "strict": true,
        "pretty": true,
        "removeComments": false,
        "baseUrl": "./src",
        //"allowSyntheticDefaultImports": true,
        "outDir": "./randomwallpaper@iflow.space",
