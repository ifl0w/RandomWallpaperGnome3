{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2020",
        "lib": [
            "ES2022"
        ],
        "sourceMap": false,
        "strict": true,
        "pretty": true,
        "removeComments": false,
        "baseUrl": "./src",
        "outDir": "./randomwallpaper@iflow.space",
        "skipLibCheck": true, // TODO: this should not be necessary and points to an error in the configuration
        "types": [
            "./types/mappings"
        ]
    },
    "include": [
        "./types/mappings/index.d.ts",
        "./src/**/*.ts",
        "randomwallpaper@iflow.space/**/*.js"
    ],
    "exclude": []
}
