        //    // > The functions in this module are available globally, without import.
        //],
        //"typeRoots": [
        //    "./types",
        //],
        "types": [
        ////    "mappings", // mappings 'from @girs' to 'gi://'
        //    "./types/ui", // shell import types
        //    "./types/misc", // extension import types
        //    //"./node_modules/@girs/gjs/ambient.d.ts"
                "./types/mappings"
        ],

    },
    "include": [
        "./types/mappings/index.d.ts",
        "./src/**/*.ts",
        "randomwallpaper@iflow.space/**/*.js"
    ],
    "exclude": [
    //    "./types/**"
    ],
